# Demo values only. Never commit a real .env.
# Option 1: a single connection string (takes priority when non-empty)
POSTGRES_CONNECTION_STRING=postgresql://demo_user:demo_password@localhost:5432/demo_db

# Option 2: separate variables (used when the connection string is empty)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE_NAME=demo_db
# POSTGRES_USERNAME=demo_user
# POSTGRES_PASSWORD=demo_password

# Optional: PostgreSQL for integration tests. The tests drop and truncate tables, so
# the database must be local, its name must end in _test, and it must never be the
# application's own database (the tests refuse anything else). Without it the
# PostgreSQL tests are skipped.
# TEST_DATABASE_URL=postgresql+psycopg://demo_user:demo_password@localhost:5432/demo_test

# Events Provider (the key is a secret: set it in LMS Profile, never commit it)
EVENTS_PROVIDER_BASE_URL=http://events-provider.dev-2.python-labs.ru
EVENTS_PROVIDER_API_KEY=demo-key

# Optional: public origin for absolute pagination links (next/previous) when the
# app runs behind a TLS-terminating proxy. Origin only, no path. Unset = use the request URL.
# PUBLIC_BASE_URL=https://yuriynik156-events-aggregator.dev-2.python-labs.ru

# Optional: seconds between automatic background syncs. Default 86400 (24 hours),
# minimum 60, 0 turns the background sync off (the manual POST /api/sync/trigger stays).
# SYNC_INTERVAL_SECONDS=86400
