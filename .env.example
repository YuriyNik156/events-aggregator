# Demo values only. Never commit a real .env.
# Option 1: a single connection string (takes priority when non-empty)
POSTGRES_CONNECTION_STRING=postgresql://demo_user:demo_password@localhost:5432/demo_db

# Option 2: separate variables (used when the connection string is empty)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DATABASE_NAME=demo_db
# POSTGRES_USERNAME=demo_user
# POSTGRES_PASSWORD=demo_password

# Optional: PostgreSQL for integration tests (must NOT be a production database)
# TEST_DATABASE_URL=postgresql+psycopg://demo_user:demo_password@localhost:5432/demo_test

# Events Provider (the key is a secret: set it in LMS Profile, never commit it)
EVENTS_PROVIDER_BASE_URL=http://events-provider.dev-2.python-labs.ru
EVENTS_PROVIDER_API_KEY=demo-key
